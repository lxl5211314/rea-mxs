# 复制为 .env 后填写；已存在的系统环境变量优先

# ---------- A. 智能交付本机 relay（推荐，免费、无需外网 key；前提是本机 opencode 在跑）
OPENAI_BASE_URL=http://127.0.0.1:19300/v1
OPENAI_API_KEY=local-yonyou-relay
LLM_MODEL=deepseek-v4.1-flash
# 该模型会先输出 reasoning_content，正文首字被思考拖慢：
#   默认 5.4~6.1s / minimal 2.3~3.9s / 关掉思考 0.4~0.8s（推荐）
LLM_REASONING_EFFORT=
# 关思考（Ark/火山系网关通用写法；被拒时 Brain 会自动降级重试）
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 保活：这条链路冷启动首字 3.8s、热着 0.4s，空闲 50s 自动补一发 1 token
LLM_WARM=1

# ---------- B. 直连 DeepSeek（有外网 key 时用，二选一）
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=deepseek-flash

# ---------- 声音
# ASR：本地 faster-whisper。base=0.2s@cuda/1.6s@cpu（准），tiny=0.8s（略错字）
ASR_MODEL=faster-whisper-base
# 抓哪个输出设备的回环（写名字的一部分，如「耳机」「Realtek」）；不写=系统默认输出
# AUDIO_DEVICE=耳机
# 默认输出被静音时自动解除（音量近 0 才补到 0.3，正常音量不动）
AUDIO_AUTOFIX=1
# 20s 采不到声音时自动回退到默认输出设备（对应官网「外放单路模式」）
AUDIO_FALLBACK=1

# 早触发：说话过程中每 PARTIAL_STEP 秒跑一次中间识别，命中疑问词就先发 LLM
PARTIAL_STEP=1.2
EARLY_ASK=1
# 长问句优化（实验，默认关）：关掉早触发、把 hangover 拉到 0.9s，等面试官说完再答
# LONG_Q=1
# 预断句抢跑：静音 0.3s 就先猜一把，0.6s 才正式断句
SPEC_HANG=0.3
SILENCE_HANG=0.6

# ---------- 回答
# brief≈200 字 / standard≈400 字 / detailed≈800 字 / outline≈300 字要点
ANSWER_STYLE=standard
# 回答太短/太长时直接改这个上限
# LLM_MAX_TOKENS=800

# 角色与简历要点，直接影响答案质量
ROLE=后端工程师，5 年经验，主做 Java/Spring Cloud 与订单中台
RESUME=负责订单中心重构，QPS 从 800 提升到 6000；主导分库分表；带 4 人小组

# ---------- 模式
# interview=面试：系统音频 → VAD → ASR → 问题判定 → 作答（start.bat）
# exam     =笔试：只截图 → 视觉模型 → 答案，**不采集音频、不跑 ASR**（start-exam.bat）
# 注意：start.bat 强制 MODE=interview，start-exam.bat 强制 MODE=exam（bat 优先于本文件）
MODE=interview
# 笔试：编程语言与代码模式
EXAM_LANG=自动识别
EXAM_STYLE=力扣（只写核心函数）
# 两种设为 ACM（含输入输出完整程序）

# ---------- 截图 → 视觉模型
# 实测同一张题图：flash 首字 1.4s/总 3.4s；GLM-5.3 首字 4.7s/总 5.8s
VISION_MODEL=deepseek-v4.1-flash
# VISION_MODEL=GLM-5.3
VISION_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 鼠标手势：Shift+双击整屏 / Alt+双击窗口 / Shift+Alt+双击长截图
SHOT_MOUSE=1
# 考场低痕迹建议改 0：关闭鼠标低级钩子，只用 Ctrl+Shift+1/2/3 截图
# 手势可配：点击次数（1/2/3）与鼠标键（left/right/middle/x）
SHOT_CLICKS=2
SHOT_BUTTON=left
# 双击判定窗口（秒）与位置容差（像素）：手慢调大，误触发调小
SHOT_INTERVAL=0.85
SHOT_DIST=24
# 取图前把浮窗临时透明，避免截到自己
SHOT_HIDE_UI=1
# 长截图第二次双击的等待时间（秒）
# SHOT_LONG_TIMEOUT=60
# 笔试安全模式：强制关动作捕捉/手机端口/语音，窗口默认隐藏+点击穿透，F8 显示
EXAM_SAFE=0

# ---------- 题库
# 「问题,答案」两列 CSV/TSV，命中就直接念你写好的答案，不花时间调模型
# BANK_CSV=E:\aaa_msx\clone\题库.csv
# BANK_THRESHOLD=0.86

# ---------- 伪装与窗口
# 共享内容列表/任务栏里显示的窗口名
WIN_TITLE=Settings
# CLOAK=0 关闭伪装（调试时用）
CLOAK=1
# 控制台窗口也反截屏：本地看得见日志，共享屏幕/录屏里看不见（双击 bat 启动时生效）
CLOAK_CONSOLE=1
# 笔试启动即最小化控制台（最小化窗口不进屏幕共享；任务栏点开还能看日志，关掉即退出）
# 想一直盯着日志就设 0
CONSOLE_MIN=1
# 更彻底：直接隐藏控制台窗口（任务栏按钮也消失，整屏共享里完全看不到）
# 隐藏后靠 Ctrl+Shift+Q 两下退出；要看日志就打开 clone\run.log。设 0 回落为最小化
CONSOLE_HIDE=1
# 控制台标题（和浮窗一样伪装；默认跟随 WIN_TITLE）
CONSOLE_TITLE=Settings
# 托盘图标：整屏共享时通知区会露出灰色 S，默认关；设 1 才显示
TRAY=0
# 「叫出窗口」的本机回环端口（只绑 127.0.0.1）：窗口隐藏后再启动一次，
# 新进程通过它让已有实例显示窗口，然后自己退出
SHOW_PORT=19399
# 热键吞掉不外漏（浏览器不会收到 Ctrl+Shift+B 书签、Ctrl+Shift+S 另存为等）
HOTKEY_SUPPRESS=1
# 隐身保活：每 5 秒重设 WDA_EXCLUDEFROMCAPTURE（驱动重建窗口会丢）
STEALTH_KEEPALIVE=1

# ---------- 双机位
# 语音播报（仅笔试）：答案只从耳机读出来，屏幕不出字
TTS=0
# TTS_VOICE=Microsoft Huihui Desktop
# 手机联动：同一个 Wi-Fi，手机浏览器打开终端里打印的地址
# 当前默认关（不需要手机端，也少一个局域网端口暴露面）；要双机位再改 1
MOBILE=0
# theme: dark / blue / large (Ctrl+Alt+Y toggles at runtime)
THEME=dark
MOBILE_PORT=8765
# 第一题开始 3 秒后把本机窗口藏起来（答案只在手机上看，适合第二机位）
# MOBILE_HIDE=1

# ---------- 动作捕捉（0.3.84+ 同类能力，默认关）
# 本机识别，画面不上传不落盘；触发后 3.5s 冷却
GESTURE=0
# glasses=食指停在鼻梁 0.5s / blink=快速眨两下（间隔<=0.5s）
GESTURE_MODE=glasses
# 摄像头序号
# GESTURE_CAM=0
# 扶眼镜保持秒数（超过 5s 当托脸，不触发）
# GESTURE_HOLD=0.5

# 模型目录（离线模型放这里）
MSX_MODELS_DIR=E:\aaa_msx\models

# ---------- 设置中心
# 模型档位：speed=灵动（默认，先出字）/ natural=睿智（更像真人，首字慢半拍）
LLM_PROFILE=speed
# 速答：先一句话结论，再被完整回答覆盖（不想要设 0，首字能快约 0.15s）
QUICK_ANSWER=1
# 外语面试：英文问题先给一行中文对照（中文问题无额外开销）
TRANSLATE=1
# 资料目录（默认 clone\\资料）：简历.*（1 份）、知识库\\*（最多 2 份）、提示词_面试.txt / 提示词_笔试.txt
# MSX_PROFILE_DIR=E:\\aaa_msx\\clone\\资料

# ---------- 笔试加固
# 截图手势：连击次数 1/2/3 与按键 left/right/middle/x1/x2
SHOT_CLICKS=2
# 双击判定窗口（秒）/ 位置容差（像素）；键盘兜底是 Ctrl+Shift+1/2/3
SHOT_INTERVAL=0.85
SHOT_DIST=24
SHOT_BUTTON=left
# 截图前把自己藏起来（避免截到自己）
SHOT_HIDE_UI=1
# 笔试安全模式：关动作捕捉/手机联动/语音播报，窗口默认隐藏+点击穿透（F8 显示）
EXAM_SAFE=0
# 控制台也加入反截屏（WDA_EXCLUDEFROMCAPTURE）
CLOAK_CONSOLE=1
# 启动即最小化控制台（最小化窗口不进屏幕共享）
CONSOLE_MIN=1
# 全局热键吞键：不让浏览器收到 Ctrl+Shift+B/S 等组合（方向键除外）
HOTKEY_SUPPRESS=1
# 反截屏保活：每 5 秒重新校准一次 WDA（对抗系统/驱动重置）
STEALTH_KEEPALIVE=1

# ---------- 笔试读题（CDP）与看护
DOM=1
DOM_AUTO=0
DOM_CDP=http://127.0.0.1:9223
STEALTH_SELFCHECK=0
GUARDIAN_MAX=0
GUARDIAN_DELAY=1.5
EXAM_LANG=自动识别
EXAM_STYLE=力扣（只写核心函数）

# --- 笔试窗口形态 ---
# EXAM_GHOST=0：常驻可见（推荐）。未截图时显示快捷键卡片，截图瞬间自动隐身；
#               屏幕共享/录屏里本来就不出现（WDA），GDI 抓屏也抓不到分层窗口。
# EXAM_GHOST=1：幽灵窗。启动就不显示，答案到达才出现，GHOST_HIDE_AFTER 秒后自动消失。
EXAM_GHOST=0
GHOST_HIDE_AFTER=10
# 未截图时在主区域显示快捷键卡片（EXAM_GHOST=0 时生效）
EXAM_IDLE=1
